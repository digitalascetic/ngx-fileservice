{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "@digitalascetic/ngx-fileservice": {
            "root": "projects/digitalascetic/ngx-fileservice",
            "sourceRoot": "projects/digitalascetic/ngx-fileservice/src",
            "projectType": "library",
            "prefix": "ascfil",
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/digitalascetic/ngx-fileservice/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/digitalascetic/ngx-fileservice/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "projects/digitalascetic/ngx-fileservice/tsconfig.spec.json",
                        "polyfills": [
                            "zone.js",
                            "zone.js/testing"
                        ]
                    }
                }
            }
        }
    }
}
