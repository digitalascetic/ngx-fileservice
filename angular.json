{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "@digitalascetic/ngx-fileservice": {
            "root": "projects/digitalascetic/ngx-fileservice",
            "sourceRoot": "projects/digitalascetic/ngx-fileservice/src",
            "projectType": "library",
            "prefix": "ascfil",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:ng-packagr",
                    "options": {
                        "project": "projects/digitalascetic/ngx-fileservice/ng-package.json"
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/digitalascetic/ngx-fileservice/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/digitalascetic/ngx-fileservice/tsconfig.lib.json"
                        }
                    }
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "tsConfig": "projects/digitalascetic/ngx-fileservice/tsconfig.spec.json",
                        "polyfills": [
                            "zone.js",
                            "zone.js/testing"
                        ]
                    }
                },
                "lint": {
                    "builder": "@angular-devkit/build-angular:tslint",
                    "options": {
                        "tsConfig": [
                            "projects/digitalascetic/ngx-fileservice/tsconfig.lib.json",
                            "projects/digitalascetic/ngx-fileservice/tsconfig.spec.json"
                        ],
                        "exclude": [
                            "**/node_modules/**"
                        ]
                    }
                }
            }
        }
    }
}
